# Copy to .env to override docker-compose defaults. Never commit a real .env.
# All values below are safe local-development settings.

# ── Model providers ───────────────────────────────────────────────────────────
# Laya: local structured-decision model (rust-ml-runtime), run in-process by the
# worker. 1 = enabled (the `models` service installs it into a volume), 0 = off.
LOMI_LAYA=1
# Deployment defaults per role. Defaults may only name LOCAL providers.
# extraction: laya | none        semantic: laya | none
# (Anthropic is never a deployment default: a tenant must choose it and authorize
#  external processing in Operations → Model processing.)
LOMI_SEMANTIC_PROVIDER=laya
LOMI_EXTRACTION_PROVIDER=laya
# Development only: identity for REST calls that send no token (remove in production).
LOMI_DEV_DEFAULT_TOKEN=dev-lakeside-admin

# Anthropic: registered only when a key is set; used only for tenants that chose
# it and authorized external processing.
ANTHROPIC_API_KEY=
# LOMI_EXTRACTION_MODEL=claude-opus-5-5
# LOMI_SEMANTIC_MODEL=claude-haiku-5-5

# ── Running the API/worker outside Docker (pnpm dev) ──────────────────────────
# DATABASE_URL=postgres://lomi:lomi@localhost:5432/lomi
# REDIS_URL=redis://localhost:6379
# LOMI_STORAGE_DIR=./.lomi-storage
# ML_RUNTIME_MODEL_DIR=~/.local/share/ml-runtime/models
# LOMI_DEV_LOGIN=1          # lists demo identities on the login screen; never in production
# JOB_LEASE_SECONDS=60      # how long a worker owns a job before recovery may re-run it

# ── Tests ─────────────────────────────────────────────────────────────────────
# TEST_DATABASE_URL=postgres://lomi:lomi@localhost:5432/lomi_test
# TEST_REDIS_URL=redis://localhost:6379/15
# LAYA_TEST_MODEL_DIR=~/.local/share/ml-runtime/models   # enables real-model tests
