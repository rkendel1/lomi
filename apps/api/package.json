{
  "name": "@lomi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsup src/index.ts --format esm --sourcemap --watch --onSuccess \"node dist/index.js\"",
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@appport/authorization": "1.4.0",
    "@appport/core": "1.13.0",
    "@appport/mcp": "1.5.0",
    "@appport/protocol": "1.8.0",
    "@appport/schema": "1.2.2",
    "@appport/server": "1.5.0",
    "@lomi/core": "workspace:*",
    "@lomi/docops": "workspace:*",
    "@lomi/pdf": "workspace:*",
    "@rust-ml-runtime/node": "0.3.0",
    "bullmq": "^6.7.10",
    "ioredis": "^6.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@lomi/config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "pdf-lib": "^1.17.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
